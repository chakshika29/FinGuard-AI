# ==============================================================================
# FinGuard AI - Environment Configuration Template
# Copy this file to .env and customize for your local or GCP environment.
# NEVER commit .env or service account JSON files to version control.
# ==============================================================================

# Application
APP_NAME=FinGuard AI
APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security & Authentication (CHANGE THESE IN PRODUCTION)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Demo Account Passwords (for local evaluation only)
DEMO_ADMIN_PASSWORD=Admin@FinGuard2026!
DEMO_STEWARD_PASSWORD=Steward@FinGuard2026!
DEMO_ANALYST_PASSWORD=Analyst@FinGuard2026!

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Data Backend Mode: "local" (DuckDB + SQLite metadata) or "bigquery" (GCP BigQuery + GCS)
DATA_BACKEND=local

# Local Storage Paths
LOCAL_DUCKDB_PATH=data/processed/finguard_warehouse.duckdb
LOCAL_METADATA_DB_URL=sqlite:///./data/processed/finguard_metadata.db
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLE_DIR=data/sample
POWERBI_EXPORT_DIR=powerbi/datasets

# Google Cloud Platform Configuration (Required only when DATA_BACKEND=bigquery)
GCP_PROJECT_ID=
GCP_LOCATION=US
GCS_BUCKET_NAME=
# Optional: path to service account key JSON (leave empty to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery Dataset Names
BIGQUERY_RAW_DATASET=finguard_raw
BIGQUERY_STAGING_DATASET=finguard_staging
BIGQUERY_CURATED_DATASET=finguard_curated
BIGQUERY_GOVERNANCE_DATASET=finguard_governance
BIGQUERY_ANALYTICS_DATASET=finguard_analytics

# Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=250
DEFAULT_RANDOM_SEED=42
